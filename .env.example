# Local SQLite database (stored at prisma/dev.db)
DATABASE_URL="file:./dev.db"

# Auth
JWT_SECRET="change-me-to-a-long-random-string"

# Public URL for share links (required on Vercel — use your deployment URL)
# Local dev: http://127.0.0.1:3002  (use 127.0.0.1 — localhost can be blank on some Windows setups)
# Vercel:    https://your-project.vercel.app
NEXT_PUBLIC_APP_URL="http://127.0.0.1:3002"

NEXT_PUBLIC_APP_NAME="AI Video Studio"

# AI providers (optional — mock mode works without keys)
# FAL_KEY=""
